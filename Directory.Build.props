<Project>
  <PropertyGroup>
    <Version>0.10.1</Version>
    <Product>LibreHardwareHub</Product>
    <Copyright>LibreHardwareHub Contributors</Copyright>
    <!-- .NET 8 appends "+<git hash>" to the informational version; the window title and the updater want the plain version. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
